            $('#sidebarOverlay').on('click', function() {
                $('#sidebar, #sidebarOverlay').removeClass('active');
                $(this).fadeOut();
            });

            // Summernote Init (Keep your existing function, just simplified call)
            if ($('.summernote').length > 0) {
