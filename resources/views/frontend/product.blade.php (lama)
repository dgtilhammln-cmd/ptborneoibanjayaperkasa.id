<script>
(function() {
    'use strict';
    
    const productQuoteForm = document.getElementById('productQuoteForm');
    const submitBtn = document.getElementById('submitProductQuote');
    
    if (submitBtn && productQuoteForm) {
        submitBtn.addEventListener('click', function() {
            // Validate form
            if (!productQuoteForm.checkValidity()) {
                productQuoteForm.reportValidity();
                return;
            }
            
            // Get form data
            const formData = new FormData(productQuoteForm);
            const data = Object.fromEntries(formData);
            
            // Build WhatsApp message
            let message = `*Minta Penawaran Khusus - ${data.product_name}*\n\n`;
            message += `*Nama:* ${data.name}\n`;
            message += `*WhatsApp:* ${data.phone}\n`;
            if (data.email) {
                message += `*Email:* ${data.email}\n`;
            }
            message += `*Jumlah:* ${data.quantity} Pcs\n`;
            if (data.specs) {
                message += `*Spesifikasi/Ukuran:* ${data.specs}\n`;
            }
            if (data.message) {
                message += `*Catatan:* ${data.message}\n`;
            }
            message += `\n*Produk:* ${data.product_name}\n`;
            message += `*Link Produk:* ${window.location.href}\n`;
            
            // Get WhatsApp number from settings
            const whatsappNumber = '{{ \App\Models\Setting::get("contact_phone", "03185597449") }}';
            const cleanNumber = whatsappNumber.replace(/\D/g, '');
            const whatsappLink = `https://wa.me/${cleanNumber}?text=${encodeURIComponent(message)}`;
            
            // Open WhatsApp
            window.open(whatsappLink, '_blank');
            
            // Close modal
            const modalElement = document.getElementById('productQuoteModal');
            if (modalElement) {
                const modal = bootstrap.Modal.getInstance(modalElement);
                if (modal) {
                    modal.hide();
                }
            }
            
            // Reset form
            productQuoteForm.reset();
        });
    }
})();
</script>
